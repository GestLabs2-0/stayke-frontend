# ============================================================
# Stayke — Environment Variables
# Copy this file to `.env.local` (or `.env`) and fill the values.
# Everything here is public (NEXT_PUBLIC_*) and exposed to the browser.
# ============================================================

#########################
###### BACKEND (API) ####
#########################

# Base URL of the Stayke backend REST API.
# Only used in production builds via EmbeddedProvider (apiBaseUrl).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1.0

# Public URL of this frontend. REQUIRED — the app throws at boot if empty.
# Used by the Dynamic SDK (universalLink and Phantom redirect deep links).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# JWT lifetime in seconds accepted by the backend session.
NEXT_PUBLIC_JWT_DURATION=86400

#########################
####### DYNAMIC #########
# The wallet / auth SDK by Dynamic. Get an Environment ID from your
# Dynamic dashboard: https://app.dynamic.xyz
# Docs: https://docs.dynamic.xyz
#########################

# Your Dynamic Environment ID. REQUIRED — the app throws at boot if empty.
NEXT_PUBLIC_DYNAMIC_CLIENT_ID=your_dynamic_environment_id

#########################
####### SOLANA RPC ######
# Recommended free RPC providers for Solana:
#  - Alchemy:  https://www.alchemy.com  (https://www.alchemy.com/chain-connect/chain/solana)
#  - Helius:   https://www.helius.dev
#  - QuickNode: https://www.quicknode.com
#  - Solana official public RPCs: https://api.mainnet-beta.solana.com /
#                                 https://api.devnet.solana.com (rate-limited)
#########################

# WebSocket RPC for the Solana network.
# Fallback: derived from NEXT_PUBLIC_RPC_URL replacing http -> ws.
NEXT_PUBLIC_WS_URL=ws://localhost:8900

# HTTP RPC for the Solana network (used by @solana/kit and Dynamic).
# Example (Alchemy Devnet):
#   NEXT_PUBLIC_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_RPC_URL=http://localhost:8899

# Solana genesis hash. Used by the `custom` (localhost) network entry
# to build a NetworkData object for Dynamic. Optional.
NEXT_PUBLIC_SOLANA_GENESIS_HASH=

# Solana commitment level: processed | confirmed | finalized.
NEXT_PUBLIC_COMMITMENT=confirmed

# Default Solana cluster on first load.
# One of: mainnet | devnet | testnet | localnet
NEXT_PUBLIC_DEFAULT_NETWORK=devnet

# R2 public URL to build images
NEXT_PUBLIC_PROPERTY_IMAGE_URL=
